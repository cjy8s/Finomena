
# Python cache
__pycache__/
*.pyc
*.pyo

# Project data folders
/Input/
/Output/

# Original script files, no longer needed
/Script/

# Portable R runtime — populated locally by setup_dev.bat / setup_dev.sh
# Never commit: platform-specific binaries, hundreds of MB
/App/R/runtime/

# Build artifacts
/App/dist/
/App/build/
/App/Output/

