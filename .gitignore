# --- Local-only folders (not to be tracked) ---
Data/
OG R script/
*.xlsx

# --- IDE / tooling state ---
.claude/
.vscode/
.idea/
.Rproj.user/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# --- PyInstaller build artifacts ---
Finomena/App/build/
Finomena/App/dist/
Finomena/App/*.manifest

# --- R bundled library and runtime droppings ---
# (downstream installer reads install_packages.R and fetches packages itself;
#  we do NOT commit the bundled R package binaries.)
Finomena/App/R/library/
**/.Rhistory
**/.RData

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini
